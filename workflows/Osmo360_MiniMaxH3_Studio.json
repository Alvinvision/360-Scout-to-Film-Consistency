      "widgets_values": [
        "MiniMax H3",
        "Create one 10-second cinematic video with exactly four shots and three cuts. Images 1–5 are overlapping directions of one location. Preserve its architecture, vehicles, props and daylight. Image 6 is Talent A and image 7 is Talent B; each identity sheet describes one person. Match their faces and wardrobe. Keep both people on fixed marks facing each other. Shot 1, 0–3s: wide two-person establishing pan. Shot 2, 3–5s: three-quarter over Talent A's shoulder onto Talent B. Shot 3, 5–7s: reverse over Talent B's shoulder onto Talent A. Shot 4, 7–10s: one continuous camera arc across their dialogue axis, ending in a wider environment pan with both people still visible. Keep the same physical location and actor positions through every cut. Full-frame live-action footage, no collage or text.",
        "768P",
        "16:9",
        10,
        424242,
        "fixed",
        false
      ],
      "widgets_values_named": {
        "model": "MiniMax H3",
        "model.prompt": "Create one 10-second cinematic video with exactly four shots and three cuts. Images 1–5 are overlapping directions of one location. Preserve its architecture, vehicles, props and daylight. Image 6 is Talent A and image 7 is Talent B; each identity sheet describes one person. Match their faces and wardrobe. Keep both people on fixed marks facing each other. Shot 1, 0–3s: wide two-person establishing pan. Shot 2, 3–5s: three-quarter over Talent A's shoulder onto Talent B. Shot 3, 5–7s: reverse over Talent B's shoulder onto Talent A. Shot 4, 7–10s: one continuous camera arc across their dialogue axis, ending in a wider environment pan with both people still visible. Keep the same physical location and actor positions through every cut. Full-frame live-action footage, no collage or text.",
